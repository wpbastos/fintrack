// Prisma schema for FinTrack
// 3 core tables: ImportLog, StagingTransactions, Transactions

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Import Log (audit trail) - tracks every import batch
model ImportLog {
  id                   Int       @id @default(autoincrement()) @map("ImportID")
  fileName             String    @map("FileName")
  filePath             String?   @map("FilePath")
  sourceType           String    @map("SourceType") // Statement, Receipt, Payslip, Manual
  accountId            Int?      @map("AccountID") // FK removed for now
  periodStart          DateTime? @map("PeriodStart")
  periodEnd            DateTime? @map("PeriodEnd")
  openingBalance       Float?    @map("OpeningBalance")
  closingBalance       Float?    @map("ClosingBalance")
  transactionCount     Int       @default(0) @map("TransactionCount")
  addedCount           Int       @default(0) @map("AddedCount")
  matchedCount         Int       @default(0) @map("MatchedCount")
  skippedCount         Int       @default(0) @map("SkippedCount")
  unknownCount         Int       @default(0) @map("UnknownCount")
  contentHash          String?   @unique @map("ContentHash")
  statementFingerprint String?   @unique @map("StatementFingerprint") // {AccountID}|{PeriodEnd}|{ClosingBalance}|{TxnCount}
  status               String    @default("Pending") @map("Status") // Pending, Processing, Completed, Failed, Partial
  processedAt          DateTime? @map("ProcessedAt")
  archivedPath         String?   @map("ArchivedPath")
  notes                String?   @map("Notes")
  createdAt            DateTime  @default(now()) @map("CreatedAt")

  // Relations
  stagingTransactions StagingTransaction[]
  transactions        Transaction[]

  @@map("ImportLog")
}

// Staging table for batch imports (temporary holding)
// Transactions land here first, get reviewed, then move to Transactions
model StagingTransaction {
  id                   Int       @id @default(autoincrement()) @map("StagingID")
  importBatchId        String    @map("ImportBatchID") // Groups transactions from same import
  rawDate              String?   @map("RawDate") // Date as read from statement (unparsed)
  rawDescription       String?   @map("RawDescription") // Description as read from statement
  rawAmount            Float?    @map("RawAmount") // Amount as read (NEGATIVE=expense, POSITIVE=income)
  accountId            Int?      @map("AccountID") // FK removed for now
  sourceFile           String?   @map("SourceFile") // Original filename

  // Resolved after batch matching:
  resolvedDate           DateTime?     @map("ResolvedDate") // Parsed/cleaned date
  resolvedMerchantId     Int?          @map("ResolvedMerchantID")
  resolvedMerchant       Merchant?     @relation(fields: [resolvedMerchantId], references: [id])
  resolvedCategoryId     Int?          @map("ResolvedCategoryID")
  resolvedCategory       Category?     @relation(fields: [resolvedCategoryId], references: [id])
  resolvedIncomeSourceId Int?          @map("ResolvedIncomeSourceID")
  resolvedIncomeSource   IncomeSource? @relation(fields: [resolvedIncomeSourceId], references: [id])
  resolvedPersonId       Int?          @map("ResolvedPersonID")
  resolvedPerson         Person?       @relation(fields: [resolvedPersonId], references: [id])

  // Status: pending, matched, unknown, imported, skipped
  status               String    @default("pending") @map("Status")
  matchConfidence      Float?    @map("MatchConfidence") // 0.0-1.0
  notes                String?   @map("Notes")
  createdAt            DateTime  @default(now()) @map("CreatedAt")

  // Relation to ImportLog
  importLogId          Int?      @map("ImportLogID")
  importLog            ImportLog? @relation(fields: [importLogId], references: [id])

  @@map("StagingTransactions")
}

// Main Transactions table
// Central table for all financial transactions (actual and predicted)
model Transaction {
  id                  Int           @id @default(autoincrement()) @map("TransactionID")
  date                DateTime      @map("Date") // Transaction date
  description         String        @map("Description") // Clean/normalized description
  originalDescription String?       @map("OriginalDescription") // Raw from bank statement
  amount              Float         @map("Amount") // POSITIVE=income, NEGATIVE=expense
  accountId           Int?          @map("AccountID") // FK removed for now
  categoryId          Int?          @map("CategoryID")
  category            Category?     @relation(fields: [categoryId], references: [id])
  merchantId          Int?          @map("MerchantID")
  merchant            Merchant?     @relation(fields: [merchantId], references: [id])
  personId            Int?          @map("PersonID")
  person              Person?       @relation(fields: [personId], references: [id])
  incomeSourceId      Int?          @map("IncomeSourceID")
  incomeSource        IncomeSource? @relation(fields: [incomeSourceId], references: [id])

  // Import reference (nullable for manual entries)
  importId            Int?      @map("ImportID")
  importLog           ImportLog? @relation(fields: [importId], references: [id])

  // Flags
  reconciled          Boolean   @default(false) @map("Reconciled")
  isDuplicate         Boolean   @default(false) @map("IsDuplicate")
  isPredicted         Boolean   @default(false) @map("IsPredicted")
  isRecurring         Boolean   @default(false) @map("IsRecurring")
  recurringId         Int?      @map("RecurringID") // FK removed for now
  hasAllocations      Boolean   @default(false) @map("HasAllocations")

  notes               String?   @map("Notes")
  createdAt           DateTime  @default(now()) @map("CreatedAt")
  updatedAt           DateTime  @updatedAt @map("UpdatedAt")

  @@map("Transactions")
}

// Merchants (master data - one row per actual merchant)
// Stores where money is spent, with pattern matching via MerchantPatterns
model Merchant {
  id                   Int       @id @default(autoincrement()) @map("MerchantID")
  merchantName         String    @unique @map("MerchantName") // Clean display name (e.g., "Amazon", "Costco")
  defaultCategoryId    Int?      @map("DefaultCategoryID")
  defaultCategory      Category? @relation(fields: [defaultCategoryId], references: [id])
  defaultPersonId      Int?      @map("DefaultPersonID") // Who usually shops here
  defaultAccountId     Int?      @map("DefaultAccountID") // Which card usually used
  merchantType         String?   @map("MerchantType") // Classification (e.g., "Grocery", "Restaurant", "Subscription")
  website              String?   @map("Website")
  hasAlternative       Boolean   @default(false) @map("HasAlternative") // cheaper alternative exists
  alternativeName      String?   @map("AlternativeName") // Suggested alternative
  alternativeSavings   Float?    @map("AlternativeSavings") // Estimated savings per transaction
  isImpulseProne       Boolean   @default(false) @map("IsImpulseProne") // warn about impulse purchases
  isActive             Boolean   @default(true) @map("IsActive")
  notes                String?   @map("Notes")
  createdAt            DateTime  @default(now()) @map("CreatedAt")
  updatedAt            DateTime  @updatedAt @map("UpdatedAt")

  // Relations
  patterns             MerchantPattern[]
  stagingTransactions  StagingTransaction[]
  transactions         Transaction[]

  @@map("Merchants")
}

// Financial Institutions (banks, credit unions, brokerages)
model Institution {
  id              Int       @id @default(autoincrement()) @map("InstitutionID")
  institutionName String    @unique @map("InstitutionName")
  institutionType String    @map("InstitutionType") // Bank, Credit Union, Brokerage, Other
  website         String?   @map("Website")
  isActive        Boolean   @default(false) @map("IsActive")
  notes           String?   @map("Notes")
  createdAt       DateTime  @default(now()) @map("CreatedAt")

  // Relations
  accounts Account[]

  @@map("Institutions")
}

// Persons (family members who use accounts/cards or receive income)
model Person {
  id        Int      @id @default(autoincrement()) @map("PersonID")
  name      String   @unique @map("Name")
  email     String?  @map("Email")
  isActive  Boolean  @default(true) @map("IsActive")
  notes     String?  @map("Notes")
  createdAt DateTime @default(now()) @map("CreatedAt")
  updatedAt DateTime @updatedAt @map("UpdatedAt")

  // Relations
  accounts            Account[]
  transactions        Transaction[]
  stagingTransactions StagingTransaction[]
  incomeSources       IncomeSource[]

  @@map("Persons")
}

// Financial Accounts (bank accounts, credit cards, loans, investments)
model Account {
  id              Int          @id @default(autoincrement()) @map("AccountID")
  accountName     String       @map("AccountName")
  accountNumber   String?      @map("AccountNumber") // Last 4 digits or full number
  institutionId   Int?         @map("InstitutionID")
  institution     Institution? @relation(fields: [institutionId], references: [id])
  accountType     String       @map("AccountType") // Chequing, Savings, Credit Card, Line of Credit, Loan, Mortgage, Investment, RRSP, TFSA, RESP, FHSA, Other
  accountNickname String?      @map("AccountNickname")
  currency        String       @default("CAD") @map("Currency")
  creditLimit     Float?       @map("CreditLimit")
  interestRate    Float?       @map("InterestRate")
  billingCycleDay   Int?       @map("BillingCycleDay") // Day of month statement closes (1-31)
  isJoint           Boolean    @default(false) @map("IsJoint")
  primaryHolderId   Int?       @map("PrimaryHolderID")
  primaryHolder     Person?    @relation(fields: [primaryHolderId], references: [id])
  isActive          Boolean    @default(true) @map("IsActive")
  notes           String?      @map("Notes")
  createdAt       DateTime     @default(now()) @map("CreatedAt")
  updatedAt       DateTime     @updatedAt @map("UpdatedAt")

  // Relations
  incomeSources   IncomeSource[]

  @@unique([accountName, institutionId])
  @@map("Accounts")
}

// Merchant Patterns (multiple patterns can map to one merchant)
// This normalizes the pattern matching - no more duplicate merchant data
model MerchantPattern {
  id         Int      @id @default(autoincrement()) @map("PatternID")
  merchantId Int      @map("MerchantID")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  pattern    String   @unique @map("Pattern") // Pattern to match in descriptions
  priority   Int      @default(0) @map("Priority") // Higher priority wins when multiple patterns match
  notes      String?  @map("Notes")
  createdAt  DateTime @default(now()) @map("CreatedAt")

  @@map("MerchantPatterns")
}

// Category Groups (high-level grouping)
model CategoryGroup {
  id        Int      @id @default(autoincrement()) @map("GroupID")
  groupName String   @unique @map("GroupName")
  groupType String   @map("GroupType") // Income, Expense, Transfer, Investment
  sortOrder Int?     @map("SortOrder")
  isActive  Boolean  @default(true) @map("IsActive")
  notes     String?  @map("Notes")

  // Relations
  categories Category[]

  @@map("CategoryGroups")
}

// Transaction Categories (with self-reference for hierarchy)
// CategoryType is inherited from CategoryGroup.groupType
model Category {
  id               Int       @id @default(autoincrement()) @map("CategoryID")
  categoryName     String    @unique @map("CategoryName")
  groupId          Int?      @map("GroupID")
  group            CategoryGroup? @relation(fields: [groupId], references: [id])
  parentCategoryId Int?      @map("ParentCategoryID")
  parentCategory   Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories  Category[] @relation("CategoryHierarchy")
  necessityLevel   String    @default("Discretionary") @map("NecessityLevel") // Essential, Important, Discretionary, Wasteful
  monthlyBudget    Float?    @map("MonthlyBudget")
  sortOrder        Int?      @map("SortOrder") // Relative within group (1, 2, 3...)
  isActive         Boolean   @default(true) @map("IsActive")
  notes            String?   @map("Notes")
  createdAt        DateTime  @default(now()) @map("CreatedAt")
  updatedAt        DateTime  @updatedAt @map("UpdatedAt")

  // Relations
  merchants            Merchant[]
  incomeSources        IncomeSource[]
  stagingTransactions  StagingTransaction[]
  transactions         Transaction[]
  budgetPeriods        BudgetPeriod[]

  @@map("Categories")
}

// Budget Period tracking for historical budget cycles
model BudgetPeriod {
  id             Int       @id @default(autoincrement()) @map("PeriodID")
  categoryId     Int       @map("CategoryID")
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountId      Int?      @map("AccountID") // Optional: for credit card billing cycles
  periodStart    DateTime  @map("PeriodStart")
  periodEnd      DateTime  @map("PeriodEnd")
  budgetedAmount Float     @map("BudgetedAmount") // Snapshot of budget at period start
  actualSpent    Float     @default(0) @map("ActualSpent")
  status         String    @default("open") @map("Status") // open, closed
  closedAt       DateTime? @map("ClosedAt")
  notes          String?   @map("Notes")
  createdAt      DateTime  @default(now()) @map("CreatedAt")
  updatedAt      DateTime  @updatedAt @map("UpdatedAt")

  @@unique([categoryId, periodStart])
  @@map("BudgetPeriods")
}

// ============================================================================
// INCOME SOURCE TRACKING
// ============================================================================

// Income Sources (where income comes from - employers, government, investments, etc.)
// Mirrors Merchant structure for expenses
model IncomeSource {
  id               Int       @id @default(autoincrement()) @map("IncomeSourceID")
  sourceName       String    @unique @map("SourceName") // Name (e.g., "TechCorp Inc.", "CRA", "TD Dividends")
  personId         Int?      @map("PersonID") // Who receives this income
  person           Person?   @relation(fields: [personId], references: [id])
  defaultCategoryId Int?     @map("DefaultCategoryID") // Usually "Salary", "Bonus", "Dividend", etc.
  defaultCategory  Category? @relation(fields: [defaultCategoryId], references: [id])
  depositAccountId Int?      @map("DepositAccountID") // Where payments deposit
  depositAccount   Account?  @relation(fields: [depositAccountId], references: [id])

  // Payment details
  payFrequency     String?   @map("PayFrequency") // Weekly, Bi-weekly, Semi-monthly, Monthly, Irregular

  // Details
  position         String?   @map("Position") // Job title
  industry         String?   @map("Industry") // Industry sector
  location         String?   @map("Location") // Work location
  website          String?   @map("Website")
  startDate        DateTime? @map("StartDate") // Start date
  endDate          DateTime? @map("EndDate") // End date (NULL if current)

  // Current payment amount (denormalized from latest IncomeChange for quick access)
  currentGross     Float?    @map("CurrentGross")
  currentNet       Float?    @map("CurrentNet")

  isActive         Boolean   @default(true) @map("IsActive")
  notes            String?   @map("Notes")
  createdAt        DateTime  @default(now()) @map("CreatedAt")
  updatedAt        DateTime  @updatedAt @map("UpdatedAt")

  // Relations
  patterns            IncomeSourcePattern[]
  incomeHistory       IncomeChange[]
  stagingTransactions StagingTransaction[]
  transactions        Transaction[]

  @@map("IncomeSources")
}

// Income Source Patterns (multiple patterns can map to one income source)
// Same structure as MerchantPattern for consistency
model IncomeSourcePattern {
  id             Int          @id @default(autoincrement()) @map("PatternID")
  incomeSourceId Int          @map("IncomeSourceID")
  incomeSource   IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  pattern        String       @unique @map("Pattern") // Pattern to match (e.g., "TECHCORP PAYROLL", "CRA DIRECT DEP")
  priority       Int          @default(10) @map("Priority") // Higher priority wins
  notes          String?      @map("Notes")
  createdAt      DateTime     @default(now()) @map("CreatedAt")

  @@map("IncomeSourcePatterns")
}

// Income Change History (tracks all payment changes over time)
// Similar concept to BudgetPeriod but for income changes
model IncomeChange {
  id             Int          @id @default(autoincrement()) @map("IncomeChangeID")
  incomeSourceId Int          @map("IncomeSourceID")
  incomeSource   IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  effectiveDate  DateTime     @map("EffectiveDate") // When the change took effect

  // Payment amounts
  previousGross Float?    @map("PreviousGross") // NULL for initial record
  previousNet   Float?    @map("PreviousNet") // NULL for initial record
  newGross      Float     @map("NewGross")
  newNet        Float     @map("NewNet")

  // Change reason for tracking
  // Initial: First payment when started
  // Annual Review: Regular yearly review
  // Promotion: Job title/role change with raise
  // Cost of Living: Inflation adjustment
  // Role Change: New responsibilities without title change
  // Annual Recalculation: CPP/EI max reached (normal Q4 increase)
  // Bonus: One-time bonus payment
  // Partial Pay: Incomplete pay period
  // Rate Change: For investments/dividends
  // Detected: System auto-detected change >5%
  // Other: Miscellaneous
  changeReason  String    @map("ChangeReason")

  notes         String?   @map("Notes")
  createdAt     DateTime  @default(now()) @map("CreatedAt")

  @@unique([incomeSourceId, effectiveDate])
  @@map("IncomeChanges")
}
